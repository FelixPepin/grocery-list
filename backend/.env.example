# Local development values only, they match the defaults in docker-compose.yml.
# Real production secrets would never be put in this file.

# MySQL Server address

DB_HOST=127.0.0.1

# Port used by MySQL

DB_PORT=3307

# MySQL user name

DB_USER=grocery_user

# MySQL password

DB_PASSWORD=grocery_pass

# Database name

DB_NAME=grocery_list

# Express server port

PORT=3000

# Frontend URL

FRONTEND_URL=http://localhost:5173