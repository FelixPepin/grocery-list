{
  "info": {
    "_postman_id": "37ccc712-1d46-4a61-824b-986af6ad81fb",
    "name": "Grocery List API",
    "description": "Requests and automated tests for the grocery list REST API.\n\nRun the whole collection with **Run collection** (order matters: \"Create item - valid\" saves `itemId`).\n\nRequires the backend on http://localhost:3000 and the MySQL container (`docker compose up -d`).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "event": [
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Runs after EVERY request of the collection",
          "pm.test(\"Response is JSON\", () => {",
          "  pm.expect(pm.response.headers.get(\"Content-Type\")).to.include(\"application/json\");",
          "});",
          "",
          "pm.test(\"Response has the standard envelope\", () => {",
          "  const body = pm.response.json();",
          "  pm.expect(body).to.have.property(\"status\", pm.response.code);",
          "  pm.expect(body).to.have.property(\"message\");",
          "  pm.expect(body.path).to.be.a(\"string\");",
          "  pm.expect(new Date(body.timestamp).toString()).to.not.eql(\"Invalid Date\");",
          "});",
          "",
          "pm.test(\"Response time is under 1s\", () => {",
          "  pm.expect(pm.response.responseTime).to.be.below(1000);",
          "});"
        ]
      }
    }
  ],
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000"
    },
    {
      "key": "itemId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "grocery_list",
      "item": [
        {
          "name": "Get all items",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));",
                  "",
                  "const items = pm.response.json().data;",
                  "",
                  "pm.test(\"data is an array\", () => pm.expect(items).to.be.an(\"array\"));",
                  "",
                  "pm.test(\"Each item has the right fields and types\", () => {",
                  "  items.forEach((item) => {",
                  "    pm.expect(item).to.have.all.keys(\"id\", \"name\", \"quantity\", \"unit_price\");",
                  "    pm.expect(item.id).to.be.a(\"number\");",
                  "    pm.expect(item.name).to.be.a(\"string\").and.not.empty;",
                  "    pm.expect(Number.isInteger(item.quantity)).to.be.true;",
                  "    pm.expect(item.quantity).to.be.at.least(1);",
                  "    pm.expect(item.unit_price).to.be.a(\"number\").and.above(0); // DECIMAL returned as a number",
                  "  });",
                  "});",
                  "",
                  "pm.test(\"Items are sorted newest first (id DESC)\", () => {",
                  "  const ids = items.map((item) => item.id);",
                  "  pm.expect(ids).to.eql([...ids].sort((a, b) => b - a));",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/grocery_list",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "grocery_list"
              ]
            }
          }
        },
        {
          "name": "Create item - valid",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 201\", () => pm.response.to.have.status(201));",
                  "",
                  "const item = pm.response.json().data;",
                  "",
                  "pm.test(\"Returns the created item\", () => {",
                  "  pm.expect(item.id).to.be.a(\"number\");",
                  "  pm.expect(item.quantity).to.eql(3);",
                  "  pm.expect(item.unit_price).to.eql(0.35);",
                  "});",
                  "",
                  "pm.test(\"Name is trimmed before saving\", () => {",
                  "  pm.expect(item.name).to.eql(\"Banana\");",
                  "});",
                  "",
                  "pm.test(\"Location header points to the new item\", () => {",
                  "  pm.expect(pm.response.headers.get(\"Location\")).to.eql(`/grocery_list/${item.id}`);",
                  "});",
                  "",
                  "// Saved for the next request and for PUT / DELETE (step 4)",
                  "pm.collectionVariables.set(\"itemId\", item.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/grocery_list",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "grocery_list"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"  Banana  \",\n  \"quantity\": 3,\n  \"unit_price\": 0.35\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Get all items - contains created item",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));",
                  "",
                  "pm.test(\"The item created by the previous request is first in the list\", () => {",
                  "  const itemId = Number(pm.collectionVariables.get(\"itemId\"));",
                  "  const first = pm.response.json().data[0];",
                  "  pm.expect(first.id).to.eql(itemId);",
                  "  pm.expect(first.name).to.eql(\"Banana\");",
                  "});"
                ]
              }
            }
          ],
